{
  "name": "@skillup/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "start:api-gateway": "nx serve api-gateway",
    "start:users": "nx serve users-service",
    "start:catalog": "nx serve catalog-service",
    "start:booking": "nx serve booking-service",
    "start:payment": "nx serve payment-service",
    "start:notifications": "nx serve notifications-service",
    "start:media": "nx serve media-service",
    "typeorm:users": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/users-service/src/database/data-source.ts",
    "migration:run:users": "npm run typeorm:users -- migration:run",
    "migration:revert:users": "npm run typeorm:users -- migration:revert",
    "migration:generate:users": "npm run typeorm:users -- migration:generate",
    "schema:sync:users": "ts-node -r tsconfig-paths/register apps/users-service/src/database/sync-schema.ts"
  },
  "private": true,
  "dependencies": {
    "@grpc/grpc-js": "^1.10.8",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/common": "^10.3.9",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.9",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.9",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.9",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/typeorm": "^10.0.2",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "handlebars": "^4.7.9",
    "ioredis": "^5.4.1",
    "minio": "^8.0.7",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "tslib": "^2.6.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.9",
    "@nx/devkit": "19.3.0",
    "@nx/js": "19.3.0",
    "@nx/nest": "19.3.0",
    "@nx/node": "19.3.0",
    "@nx/webpack": "19.3.0",
    "@nx/workspace": "19.3.0",
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.6",
    "@types/sharp": "^0.31.1",
    "nx": "19.3.0",
    "prettier": "^3.3.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "typescript": "~5.4.5"
  }
}
