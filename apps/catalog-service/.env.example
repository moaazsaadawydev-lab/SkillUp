# Catalog Service Configuration
CATALOG_SERVICE_HTTP_PORT=3002
CATALOG_SERVICE_GRPC_PORT=50052

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
