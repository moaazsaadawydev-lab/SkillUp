<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Your Email - SkillHUB</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      color: #334155;
    }
    .email-wrapper {
      width: 100%;
      background-color: #f1f5f9;
      padding: 40px 10px;
    }
    .email-container {
      max-width: 580px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
      border: 1px solid #e2e8f0;
    }
    .email-header {
      background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
      padding: 36px 30px;
      text-align: center;
    }
    .brand-logo {
      font-size: 28px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.5px;
      margin: 0;
    }
    .brand-logo span {
      color: #fbbf24;
    }
    .header-subtitle {
      color: #e0e7ff;
      font-size: 14px;
      margin-top: 6px;
      font-weight: 400;
    }
    .email-body {
      padding: 36px 36px 28px 36px;
    }
    .greeting {
      font-size: 20px;
      font-weight: 700;
      color: #0f172a;
      margin-top: 0;
      margin-bottom: 16px;
    }
    .lead-text {
      font-size: 15px;
      line-height: 1.6;
      color: #475569;
      margin-bottom: 28px;
    }
    .code-container {
      background-color: #f8fafc;
      border: 2px dashed #cbd5e1;
      border-radius: 12px;
      padding: 24px 20px;
      text-align: center;
      margin-bottom: 28px;
    }
    .code-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      color: #64748b;
      margin-bottom: 10px;
    }
    .otp-code {
      font-family: 'SF Mono', Consolas, 'Liberation Mono', Menlo, Courier, monospace;
      font-size: 36px;
      font-weight: 800;
      letter-spacing: 8px;
      color: #4f46e5;
      margin: 0;
      display: inline-block;
      padding-left: 8px;
    }
    .info-card {
      background-color: #fdf2f8;
      border-left: 4px solid #ec4899;
      padding: 14px 16px;
      border-radius: 6px;
      margin-bottom: 24px;
    }
    .info-card p {
      margin: 0;
      font-size: 13px;
      line-height: 1.5;
      color: #9d174d;
    }
    .security-note {
      font-size: 13px;
      line-height: 1.6;
      color: #64748b;
      border-top: 1px solid #f1f5f9;
      padding-top: 20px;
      margin-bottom: 0;
    }
    .email-footer {
      background-color: #f8fafc;
      padding: 24px 30px;
      text-align: center;
      border-top: 1px solid #e2e8f0;
    }
    .footer-text {
      font-size: 12px;
      color: #94a3b8;
      line-height: 1.6;
      margin: 0;
    }
    .footer-links {
      margin-top: 10px;
    }
    .footer-links a {
      color: #64748b;
      text-decoration: underline;
      margin: 0 8px;
      font-size: 12px;
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <div class="email-container">
      <!-- Header -->
      <div class="email-header">
        <h1 class="brand-logo">Skill<span>HUB</span></h1>
        <div class="header-subtitle">Empowering Your Learning Journey</div>
      </div>

      <!-- Main Content -->
      <div class="email-body">
        <h2 class="greeting">Hello {{username}},</h2>
        <p class="lead-text">
          Thank you for signing up with SkillHUB! To ensure the security of your account and verify your email address, please use the verification code below:
        </p>

        <!-- OTP Code Block -->
        <div class="code-container">
          <div class="code-label">Verification Code</div>
          <div class="otp-code">{{code}}</div>
        </div>

        <!-- Expiration Alert -->
        <div class="info-card">
          <p>
            ⏰ <strong>Important:</strong> This verification code is valid for <strong>10 minutes</strong>.
          </p>
        </div>

        <!-- Security Advice -->
        <p class="security-note">
          🔒 <strong>Security Advice:</strong> Do not share this code with anyone. SkillHUB team members will never ask for your verification code. If you did not request this verification, please safely ignore this email.
        </p>
      </div>

      <!-- Footer -->
      <div class="email-footer">
        <p class="footer-text">
          &copy; {{year}} SkillHUB Monorepo Platform. All rights reserved.<br>
          This is an automated notification, please do not reply to this email.
        </p>
      </div>
    </div>
  </div>
</body>
</html>
