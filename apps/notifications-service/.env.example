# Notifications Service Configuration
NOTIFICATIONS_SERVICE_HTTP_PORT=3005
NOTIFICATIONS_SERVICE_GRPC_PORT=50055

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_NOTIFICATIONS_QUEUE=notifications_queue

# Mailer / SMTP / Push Providers
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=user_placeholder
SMTP_PASSWORD=password_placeholder
SMTP_FROM=no-reply@skillup.com
