{
  "name": "users-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/users-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/users-service",
        "main": "apps/users-service/src/main.ts",
        "tsConfig": "apps/users-service/tsconfig.app.json",
        "rootDir": ".",
        "assets": ["apps/users-service/src/assets"]
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "users-service:build"
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d apps/users-service/src/database/data-source.ts"
      }
    },
    "migration:revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d apps/users-service/src/database/data-source.ts"
      }
    }
  },
  "tags": ["scope:service", "service:users"]
}
