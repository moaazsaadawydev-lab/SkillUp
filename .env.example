# ==========================================
# SKILLUP GLOBAL ENVIRONMENT CONFIGURATION
# ==========================================
NODE_ENV=development

# ------------------------------------------
# PostgreSQL Configuration (Global / Default)
# ------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skillup_db

# ------------------------------------------
# Redis Configuration
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# RabbitMQ Configuration
# ------------------------------------------
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_USERS_QUEUE=users_queue
RABBITMQ_CATALOG_QUEUE=catalog_queue
RABBITMQ_BOOKING_QUEUE=booking_queue
RABBITMQ_PAYMENT_QUEUE=payment_queue
RABBITMQ_NOTIFICATIONS_QUEUE=notifications_queue
RABBITMQ_MEDIA_QUEUE=media_queue

# ------------------------------------------
# MinIO / S3 Storage Configuration
# ------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_DEFAULT_BUCKET=skillup-media

# ------------------------------------------
# JWT Configuration
# ------------------------------------------
JWT_SECRET=super_secret_jwt_key_skillup_change_in_production
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_skillup_change_in_production
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------
# Service Ports (HTTP & gRPC)
# ------------------------------------------
API_GATEWAY_PORT=3000

USERS_SERVICE_HTTP_PORT=3001
USERS_SERVICE_GRPC_PORT=50051

CATALOG_SERVICE_HTTP_PORT=3002
CATALOG_SERVICE_GRPC_PORT=50052

BOOKING_SERVICE_HTTP_PORT=3003
BOOKING_SERVICE_GRPC_PORT=50053

PAYMENT_SERVICE_HTTP_PORT=3004
PAYMENT_SERVICE_GRPC_PORT=50054

NOTIFICATIONS_SERVICE_HTTP_PORT=3005
NOTIFICATIONS_SERVICE_GRPC_PORT=50055

MEDIA_SERVICE_HTTP_PORT=3006
MEDIA_SERVICE_GRPC_PORT=50056
