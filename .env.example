# ==============================================================================
# SKILLHUB / SKILLUP MONOREPO ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# Global Environment Mode
NODE_ENV=development

# ==============================================================================
# 1. Backing Infrastructure Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Container & Host)
# Host Port: 5433 (to prevent collisions with local Postgres)
# Container Port: 5432
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skillhub_db
POSTGRES_MULTIPLE_DATABASES=skillhub_users,skillhub_catalog,skillhub_booking,skillhub_payment

# Host connection string (for external tools like DBeaver / pgAdmin / local dev):
POSTGRES_HOST_PORT=5433
POSTGRES_HOST=localhost

# Docker internal network connections:
POSTGRES_CONTAINER_HOST=postgres
POSTGRES_CONTAINER_PORT=5432

# ------------------------------------------------------------------------------
# Redis Configuration
# Port: 6379
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_CONTAINER_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# RabbitMQ Configuration
# AMQP Port: 5672 | Management Dashboard Port: 15672
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Connection URIs:
RABBITMQ_HOST_URI=amqp://guest:guest@localhost:5672
RABBITMQ_CONTAINER_URI=amqp://guest:guest@rabbitmq:5672

# RabbitMQ Queues:
RABBITMQ_USERS_QUEUE=users_queue
RABBITMQ_CATALOG_QUEUE=catalog_queue
RABBITMQ_BOOKING_QUEUE=booking_queue
RABBITMQ_PAYMENT_QUEUE=payment_queue
RABBITMQ_NOTIFICATIONS_QUEUE=notifications_queue
RABBITMQ_MEDIA_QUEUE=media_queue

# ------------------------------------------------------------------------------
# MinIO Object Storage Configuration
# API Port: 9000 | Web Console Port: 9001
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST_ENDPOINT=localhost
MINIO_CONTAINER_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_DEFAULT_BUCKET=skillhub-media

# ==============================================================================
# 2. Security & Authentication Configuration
# ==============================================================================
JWT_SECRET=super_secret_jwt_key_skillup_change_in_production
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_skillup_change_in_production
JWT_REFRESH_EXPIRATION=7d

# ==============================================================================
# 3. Application & Microservice Ports
# ==============================================================================

# API Gateway (HTTP REST)
API_GATEWAY_PORT=3000

# Users Service (HTTP & gRPC)
USERS_SERVICE_HTTP_PORT=3001
USERS_SERVICE_GRPC_PORT=50051

# Catalog Service (HTTP & gRPC)
CATALOG_SERVICE_HTTP_PORT=3002
CATALOG_SERVICE_GRPC_PORT=50052

# Booking Service (HTTP & gRPC)
BOOKING_SERVICE_HTTP_PORT=3003
BOOKING_SERVICE_GRPC_PORT=50053

# Payment Service (HTTP & gRPC)
PAYMENT_SERVICE_HTTP_PORT=3004
PAYMENT_SERVICE_GRPC_PORT=50054

# Notifications Service (HTTP & gRPC)
NOTIFICATIONS_SERVICE_HTTP_PORT=3005
NOTIFICATIONS_SERVICE_GRPC_PORT=50055

# Media Service (HTTP & gRPC)
MEDIA_SERVICE_HTTP_PORT=3006
MEDIA_SERVICE_GRPC_PORT=50056

# ==============================================================================
# 4. Microservice gRPC Target URLs (Inside Docker Network)
# ==============================================================================
USERS_SERVICE_GRPC_URL=users-service:50051
CATALOG_SERVICE_GRPC_URL=catalog-service:50052
BOOKING_SERVICE_GRPC_URL=booking-service:50053
PAYMENT_SERVICE_GRPC_URL=payment-service:50054
NOTIFICATIONS_SERVICE_GRPC_URL=notifications-service:50055
MEDIA_SERVICE_GRPC_URL=media-service:50056
